<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_payment_ops_qr_flow" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.payment.ops.qr.flow</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='point_of_sale']" position="inside">
                <block title="Manual Payment QR (Without Accounting)" name="payment_ops_qr_flow_block">
                    <setting string="Transfer QR Receiver Setup">
                        <div class="content-group mt16">
                            <div class="row mb-2">
                                <div class="col-lg-3 o_light_label">
                                    <label for="payment_qr_bank_bin" string="Bank BIN"/>
                                </div>
                                <div class="col-lg-9">
                                    <field name="payment_qr_bank_bin" placeholder="970422"/>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-lg-3 o_light_label">
                                    <label for="payment_qr_account_number" string="Account Number"/>
                                </div>
                                <div class="col-lg-9">
                                    <field name="payment_qr_account_number" placeholder="0123456789"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-lg-3 o_light_label">
                                    <label for="payment_qr_account_name" string="Account Name"/>
                                </div>
                                <div class="col-lg-9">
                                    <field name="payment_qr_account_name" placeholder="NGUYEN VAN A"/>
                                </div>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
