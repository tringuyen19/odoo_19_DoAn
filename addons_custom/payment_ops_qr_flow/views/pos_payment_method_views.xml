<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_payment_ops_qr_flow" model="ir.ui.view">
        <field name="name">pos.payment.method.form.payment.ops.qr.flow</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_type']" position="after">
                <field
                    name="manual_bank_qr_enabled"
                    invisible="type != 'bank' or payment_method_type != 'none'"
                    help="When enabled, choosing this payment method in POS will show transfer QR with order amount."
                />
            </xpath>
        </field>
    </record>
</odoo>
