<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_customer_vip_tier_list" model="ir.ui.view">
        <field name="name">customer.vip.tier.list</field>
        <field name="model">customer.vip.tier</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="min_amount"/>
                <field name="currency_id"/>
                <field name="pricelist_id"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_customer_vip_tier_form" model="ir.ui.view">
        <field name="name">customer.vip.tier.form</field>
        <field name="model">customer.vip.tier</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="min_amount"/>
                            <field name="currency_id"/>
                            <field name="pricelist_id"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Ghi chu cach xep hang VIP"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_customer_vip_tier" model="ir.actions.act_window">
        <field name="name">VIP Tier Rules</field>
        <field name="res_model">customer.vip.tier</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_customer_vip_tier"
        name="VIP Tier Rules"
        parent="contacts.res_partner_menu_config"
        action="action_customer_vip_tier"
        sequence="80"
        groups="base.group_system"
    />
</odoo>
