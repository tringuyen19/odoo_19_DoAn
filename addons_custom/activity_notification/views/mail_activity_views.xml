<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mail_activity_form_activity_notification" model="ir.ui.view">
        <field name="name">mail.activity.form.activity.notification</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_form_popup"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_deadline']" position="after">
                <field name="deadline_datetime"/>
                <field name="urgency_level"/>
            </xpath>
        </field>
    </record>

    <record id="view_mail_activity_search_activity_notification" model="ir.ui.view">
        <field name="name">mail.activity.search.activity.notification</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search/filter[@name='filter_user_id_uid']" position="after">
                <filter name="filter_urgency_urgent" string="Urgent" domain="[('urgency_level', '=', 'urgent')]"/>
                <filter name="filter_urgency_important" string="Important" domain="[('urgency_level', '=', 'important')]"/>
                <filter name="filter_urgency_info" string="Info" domain="[('urgency_level', '=', 'info')]"/>
            </xpath>
        </field>
    </record>

    <record id="action_my_work_dashboard" model="ir.actions.act_window">
        <field name="name">Cong viec cua toi</field>
        <field name="res_model">mail.activity</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="domain">[('user_id', '=', uid), ('active', '=', True)]</field>
        <field name="context">{'search_default_filter_user_id_uid': 1, 'group_by': ['state', 'urgency_level']}</field>
        <field name="search_view_id" ref="mail.mail_activity_view_search"/>
    </record>

    <menuitem
        id="menu_my_work_dashboard"
        name="Cong viec cua toi"
        parent="mail.menu_mail_activities_section"
        action="action_my_work_dashboard"
        sequence="5"
    />
</odoo>
